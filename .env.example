# ---------------------------------------------------------------------------
# Guelma History — environment variables
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#   cp .env.example .env
# All NUXT_* vars map onto runtimeConfig (see nuxt.config.ts).
# ---------------------------------------------------------------------------

# --- Database (CockroachDB / PostgreSQL wire protocol) ----------------------
# Connection string from the CockroachDB Cloud console:
#   Cluster → Connect → "General connection string".
#
# Format:
#   postgresql://<sql-user>:<password>@<cluster-host>:26257/defaultdb?sslmode=verify-full
#
# Notes:
# - Keep `sslmode=verify-full`: CockroachDB Cloud requires TLS. Certificates
#   are signed by a public CA, so Node.js needs no extra CA file.
# - If the password contains special characters (@ : / ? # & $ or spaces),
#   percent-encode them (e.g. $ -> %24, @ -> %40) and quote the value.
# - The SAME URL is used by the app runtime, drizzle-kit
#   (db:generate / db:push / db:migrate / db:studio) and the seed scripts.
NUXT_DATABASE_URL="postgresql://aminsab:<PASSWORD>@pink-liger-30271.j77.aws-eu-central-1.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full"

# --- Session security (REQUIRED) -------------------------------------------
# Secret used by nuxt-auth-utils to encrypt and sign the admin session cookie.
# MUST be at least 32 characters. Without it, sessions are not securely sealed
# in production. Generate one with:  openssl rand -base64 32
NUXT_SESSION_PASSWORD="change-me-to-a-random-32-char-minimum-secret"

# --- Public site URL --------------------------------------------------------
# Base URL used to build links inside emails (e.g. password-reset links).
# Set to your real domain in production.
NUXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Email (Resend) ---------------------------------------------------------
# API key for sending transactional emails (password reset, contact form,
# newsletter confirmation). Read by the nuxt-resend module, which exposes
# useResend() in server routes/utils.
# Leave empty in development: emails are logged to the console instead of sent.
# REQUIRED in production.
NUXT_RESEND_API_KEY=""

# Verified "from" address shown on outgoing emails.
NUXT_RESEND_FROM_EMAIL="Guelma History <onboarding@resend.dev>"

# Destination inbox that receives contact-form submissions.
NUXT_CONTACT_OWNER_EMAIL=""

# --- Seed accounts (development only) ----------------------------------------
# Used by the seed scripts to create test accounts. Override for any shared or
# production-like environment. Passwords must be at least 8 characters.
#
# Use STRONG, UNIQUE passwords even in development: common passwords trigger
# Chrome's "password found in a data breach" warning on every login.
# Generate one with:  openssl rand -base64 16

# Admin account (pnpm db:seed:admin):
NUXT_ADMIN_EMAIL="admin@example.com"
NUXT_ADMIN_USERNAME="admin"
NUXT_ADMIN_PASSWORD="change-me-strong-password"
#
# Author accounts (pnpm db:seed:authors):
NUXT_AUTHOR1_EMAIL="author-1@example.com"
NUXT_AUTHOR1_USERNAME="author-1"
NUXT_AUTHOR1_PASSWORD="change-me-strong-password"
##
NUXT_AUTHOR2_EMAIL="author-2@example.com"
NUXT_AUTHOR2_USERNAME="author-2"
NUXT_AUTHOR2_PASSWORD="change-me-strong-password"


# --- Media storage (Cloudinary) ---------------------------------------------
# Server-side upload of article gallery images/videos. The API secret stays on
# the server. Get these from your Cloudinary dashboard.
# NUXT_-prefixed so they auto-map onto runtimeConfig (see nuxt.config.ts).
NUXT_CLOUDINARY_CLOUD_NAME="your_cloud_name"
NUXT_CLOUDINARY_API_KEY="your_api_key"
NUXT_CLOUDINARY_API_SECRET="your_api_secret"


#THE NESTED COMMENTS ALLOWED TO SHOW - Article page
NUXT_PUBLIC_COMMENTS_MAX_INDENT=2

# --- Google AdSense ---------------------------------------------------------
# Publisher id from the AdSense dashboard. Leave empty to disable ads entirely:
# no ad markup is rendered and adsbygoogle.js is never downloaded.
NUXT_PUBLIC_ADSENSE_CLIENT="ca-pub-5369228147932673"

# Ad unit (slot) ids, one per placement. Empty slots render nothing.
# Note the plural "SLOTS": the runtimeConfig key is public.adsenseSlots.sidebar,
# and Nuxt builds the env name from the full key path.
NUXT_PUBLIC_ADSENSE_SLOTS_SIDEBAR=""

# --- Crawler control --------------------------------------------------------
# Set to "true" ONLY on preview/staging deployments: robots.txt then serves
# "Disallow: /" to search engines (Google's ad crawlers stay allowed).
# Leave empty or "false" in production, otherwise the site is de-indexed.
NUXT_PUBLIC_DISABLE_INDEXING=""